---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Projets - Finckia - Solutions SaaS développées">
  <!-- Hero Section avec fond sombre -->
  <section class="relative bg-gray-900 overflow-hidden py-32">
    <!-- Particules animées en arrière-plan -->
    <div class="absolute inset-0">
      <div class="absolute top-20 left-10 w-2 h-2 bg-primary-400 rounded-full animate-pulse"></div>
      <div class="absolute top-40 right-20 w-1 h-1 bg-primary-300 rounded-full animate-ping"></div>
      <div class="absolute bottom-20 left-1/4 w-3 h-3 bg-primary-500 rounded-full animate-bounce"></div>
    </div>
    
    <!-- Gradient animé -->
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-primary-900 animate-gradient"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 animate-fade-in">
          Nos <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-primary-600 animate-gradient-text">Projets</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto animate-fade-in-delay">
          Découvrez les solutions SaaS innovantes que nous avons développées 
          pour transformer les processus métier de nos clients.
        </p>
      </div>
    </div>
  </section>

  <!-- Projets Section -->
  <section class="py-24 bg-gray-800 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-800 to-gray-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Solutions <span class="text-primary-400">SaaS</span> Développées
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Des applications sur mesure qui répondent aux besoins spécifiques 
          de chaque secteur d'activité.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Locizi -->
        <div class="bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 p-8 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="flex items-center mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mr-4 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white">Locizi</h3>
              <p class="text-blue-400 font-semibold">Gestion immobilière</p>
            </div>
          </div>
          <p class="text-gray-300 mb-6">
            Plateforme complète de gestion de biens immobiliers permettant aux propriétaires 
            et agences de gérer leurs locations, locataires, contrats et paiements en toute simplicité.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm border border-blue-500/30">React</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Node.js</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm border border-blue-500/30">PostgreSQL</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Stripe</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-400">
              <span class="font-semibold text-white">2023</span> - En production
            </div>
            <a href="https://www.locizi.com" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 font-medium transition-colors">
              Voir le projet →
            </a>
          </div>
        </div>

        <!-- Receiveit.io -->
        <div class="bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 p-8 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="flex items-center mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-2xl flex items-center justify-center mr-4 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white">Receiveit.io</h3>
              <p class="text-green-400 font-semibold">Réception de fichiers</p>
            </div>
          </div>
          <p class="text-gray-300 mb-6">
            Plateforme sécurisée de réception et partage de fichiers pour entreprises, 
            avec gestion des permissions, suivi des téléchargements et intégration API.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-green-500/20 text-green-300 rounded-full text-sm border border-green-500/30">Vue.js</span>
            <span class="px-3 py-1 bg-green-500/20 text-green-300 rounded-full text-sm border border-green-500/30">Python</span>
            <span class="px-3 py-1 bg-green-500/20 text-green-300 rounded-full text-sm border border-green-500/30">AWS S3</span>
            <span class="px-3 py-1 bg-green-500/20 text-green-300 rounded-full text-sm border border-green-500/30">Docker</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-400">
              <span class="font-semibold text-white">2023</span> - En production
            </div>
            <a href="https://www.receiveit.io" target="_blank" rel="noopener noreferrer" class="text-green-400 hover:text-green-300 font-medium transition-colors">
              Voir le projet →
            </a>
          </div>
        </div>

        <!-- Qrious.fr -->
        <div class="bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 p-8 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="flex items-center mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-2xl flex items-center justify-center mr-4 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white">Qrious.fr</h3>
              <p class="text-indigo-400 font-semibold">Plateforme d'innovation</p>
            </div>
          </div>
          <p class="text-gray-300 mb-6">
            Plateforme collaborative d'innovation et de résolution de problèmes 
            pour entreprises, avec outils de brainstorming et gestion de projets.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-indigo-500/20 text-indigo-300 rounded-full text-sm border border-indigo-500/30">Django</span>
            <span class="px-3 py-1 bg-indigo-500/20 text-indigo-300 rounded-full text-sm border border-indigo-500/30">React</span>
            <span class="px-3 py-1 bg-indigo-500/20 text-indigo-300 rounded-full text-sm border border-indigo-500/30">PostgreSQL</span>
            <span class="px-3 py-1 bg-indigo-500/20 text-indigo-300 rounded-full text-sm border border-indigo-500/30">Redis</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-400">
              <span class="font-semibold text-white">2023</span> - En production
            </div>
            <a href="https://www.qrious.fr" target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300 font-medium transition-colors">
              Voir le projet →
            </a>
          </div>
        </div>

        <!-- Wooflow.io -->
        <div class="bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 p-8 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="flex items-center mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mr-4 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white">Wooflow.io</h3>
              <p class="text-purple-400 font-semibold">CRM WooCommerce</p>
            </div>
          </div>
          <p class="text-gray-300 mb-6">
            Plateforme de gestion de commandes WooCommerce avec CRM intégré, 
            automatisation des processus de vente et analyse des performances.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-purple-500/20 text-purple-300 rounded-full text-sm border border-purple-500/30">WordPress</span>
            <span class="px-3 py-1 bg-purple-500/20 text-purple-300 rounded-full text-sm border border-purple-500/30">PHP</span>
            <span class="px-3 py-1 bg-purple-500/20 text-purple-300 rounded-full text-sm border border-purple-500/30">MySQL</span>
            <span class="px-3 py-1 bg-purple-500/20 text-purple-300 rounded-full text-sm border border-purple-500/30">WooCommerce API</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-400">
              <span class="font-semibold text-white">2022</span> - En production
            </div>
            <a href="https://www.wooflow.io" target="_blank" rel="noopener noreferrer" class="text-purple-400 hover:text-purple-300 font-medium transition-colors">
              Voir le projet →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-gradient-to-r from-primary-900 to-primary-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-primary-900/50 to-primary-800/50"></div>
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        Prêt à créer votre <span class="text-primary-300">solution SaaS</span> ?
      </h2>
      <p class="text-xl text-primary-100 mb-10 max-w-3xl mx-auto">
        Transformez votre idée en application performante avec notre expertise 
        en développement SaaS sur mesure.
      </p>
      <a
        href="/contact"
        class="bg-white text-primary-600 hover:bg-gray-100 px-12 py-6 rounded-xl text-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-2xl hover:shadow-white/20"
      >
        Démarrer votre projet
      </a>
    </div>
  </section>
</MainLayout>

<style>
  @keyframes gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes gradient-text {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  .animate-gradient {
    background-size: 400% 400%;
    animation: gradient 15s ease infinite;
  }
  
  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }
  
  .animate-fade-in-delay {
    animation: fade-in 1s ease-out 0.3s both;
  }
  
  .animate-gradient-text {
    background-size: 200% 200%;
    animation: gradient-text 3s ease infinite;
  }
</style>

