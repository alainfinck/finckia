---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Contact - Finckia - Développement SaaS sur mesure avec IA"
  description="Prêt à transformer votre entreprise ? Contactez Alain Finckenbein pour discuter de votre projet SaaS et découvrir comment nous pouvons vous aider."
  image="/img/logo-finckia2.png"
  ogType="website"
  twitterCard="summary_large_image"
>
  <!-- Hero Section avec fond sombre -->
  <section class="relative bg-gray-900 overflow-hidden py-32">
    <!-- Particules animées en arrière-plan -->
    <div class="absolute inset-0">
      <div class="absolute top-20 left-10 w-2 h-2 bg-primary-400 rounded-full animate-pulse"></div>
      <div class="absolute top-40 right-20 w-1 h-1 bg-primary-300 rounded-full animate-ping"></div>
      <div class="absolute bottom-20 left-1/4 w-3 h-3 bg-primary-500 rounded-full animate-bounce"></div>
    </div>
    
    <!-- Gradient animé -->
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-primary-900 animate-gradient"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 animate-fade-in">
          Contactez <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-primary-600 animate-gradient-text">Alain</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto animate-fade-in-delay">
          Prêt à transformer votre entreprise ? Discutons de votre projet 
          et découvrons comment nous pouvons vous aider à atteindre vos objectifs.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form Section avec design sombre -->
  <section class="py-24 bg-gray-800 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-800 to-gray-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Démarrer votre projet</h2>
          <form class="space-y-6" id="contact-form">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-gray-300 mb-2">
                  Prénom *
                </label>
                <input
                  type="text"
                  id="first-name"
                  name="first-name"
                  required
                  class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-white placeholder-gray-400"
                  placeholder="Votre prénom"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-gray-300 mb-2">
                  Nom *
                </label>
                <input
                  type="text"
                  id="last-name"
                  name="last-name"
                  required
                  class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-white placeholder-gray-400"
                  placeholder="Votre nom"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-white placeholder-gray-400"
                placeholder="votre@email.com"
              />
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-gray-300 mb-2">
                Entreprise
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-white placeholder-gray-400"
                placeholder="Nom de votre entreprise"
              />
            </div>

            <div>
              <label for="service" class="block text-sm font-medium text-gray-300 mb-2">
                Service d'intérêt *
              </label>
              <select
                id="service"
                name="service"
                required
                class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-white"
              >
                <option value="">Sélectionnez un service</option>
                <option value="saas">Développement SaaS</option>
                <option value="ai">Intelligence Artificielle</option>
                <option value="consulting">Consulting & Formation</option>
                <option value="maintenance">Maintenance & Support</option>
                <option value="other">Autre</option>
              </select>
            </div>

            <div>
              <label for="budget" class="block text-sm font-medium text-gray-300 mb-2">
                Budget estimé
              </label>
              <select
                id="budget"
                name="budget"
                class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-white"
              >
                <option value="">Sélectionnez une fourchette</option>
                <option value="10k-25k">10k - 25k €</option>
                <option value="25k-50k">25k - 50k €</option>
                <option value="50k-100k">50k - 100k €</option>
                <option value="100k+">100k+ €</option>
                <option value="discuss">À discuter</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-300 mb-2">
                Description du projet *
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-white placeholder-gray-400"
                placeholder="Décrivez votre projet, vos objectifs et vos besoins..."
              ></textarea>
            </div>

            <div class="flex items-start">
              <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                class="mt-1 h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-600 bg-gray-700 rounded"
              />
              <label for="privacy" class="ml-2 text-sm text-gray-300">
                J'accepte que mes données soient traitées conformément à la 
                <a href="/privacy" class="text-primary-400 hover:text-primary-300">politique de confidentialité</a>
              </label>
            </div>

            <button
              type="submit"
              class="w-full bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white font-semibold py-4 px-6 rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg"
            >
              Envoyer le message
            </button>
          </form>
        </div>

        <!-- Contact Info avec photo d'Alain -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Informations de contact</h2>
          
          <!-- Photo d'Alain -->
          <div class="mb-8">
            <div class="w-48 h-48 mx-auto mb-6 relative">
              <!-- Effet de glow animé discret -->
              <div class="absolute inset-0 bg-gradient-to-r from-primary-400 via-primary-500 to-primary-600 rounded-2xl blur-lg opacity-20 animate-pulse"></div>
              <div class="absolute inset-1 bg-gradient-to-r from-primary-300 via-primary-400 to-primary-500 rounded-2xl blur-md opacity-15"></div>
              <!-- Photo avec effet de bordure subtile -->
              <div class="relative z-10 w-full h-full bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-1">
                <img src="/img/team/alain-finckenbein.png" alt="Alain Finckenbein - Fondateur de Finckia" class="w-full h-full object-contain rounded-xl bg-transparent" />
              </div>
            </div>
            <div class="text-center">
              <h3 class="text-xl font-bold text-white mb-2">Alain Finckenbein</h3>
              <p class="text-primary-400 font-semibold">Fondateur & CEO</p>
            </div>
          </div>
          
          <div class="space-y-8">
            <div class="flex items-start">
              <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-600 rounded-lg flex items-center justify-center mr-4 shadow-lg">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Email</h3>
                <p class="text-gray-300">alain@wallprint.fr</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-600 rounded-lg flex items-center justify-center mr-4 shadow-lg">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Téléphone</h3>
                <p class="text-gray-300">06 76 38 01 52</p>
                <p class="text-gray-300">Lun-Ven: 9h-18h</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-600 rounded-lg flex items-center justify-center mr-4 shadow-lg">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Adresse</h3>
                <p class="text-gray-300">25 rue du Falkenstein</p>
                <p class="text-gray-300">67220 Saint-Pierre-Bois, Alsace, France</p>
              </div>
            </div>
          </div>

          <!-- FAQ Section -->
          <div class="mt-12">
            <h3 class="text-xl font-bold text-white mb-6">Questions fréquentes</h3>
            <div class="space-y-4">
              <div class="bg-gray-700/50 backdrop-blur-sm border border-gray-600/30 rounded-lg p-4">
                <h4 class="font-semibold text-white mb-2">Combien de temps dure un projet ?</h4>
                <p class="text-gray-300 text-sm">
                  La durée varie selon la complexité du projet. Un projet simple peut prendre 2-3 mois, 
                  tandis qu'un projet complexe peut s'étendre sur 6-12 mois.
                </p>
              </div>
              <div class="bg-gray-700/50 backdrop-blur-sm border border-gray-600/30 rounded-lg p-4">
                <h4 class="font-semibold text-white mb-2">Proposez-vous un accompagnement post-lancement ?</h4>
                <p class="text-gray-300 text-sm">
                  Oui, nous proposons des services de maintenance, support et évolution 
                  pour assurer le succès de votre application.
                </p>
              </div>
              <div class="bg-gray-700/50 backdrop-blur-sm border border-gray-600/30 rounded-lg p-4">
                <h4 class="font-semibold text-white mb-2">Quelles sont les modalités de paiement ?</h4>
                <p class="text-gray-300 text-sm">
                  Nous proposons des échéances adaptées à votre projet : 
                  acompte à la signature, paiements échelonnés selon les livrables.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section avec design sombre -->
  <section class="py-24 bg-gray-900 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900 to-black"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-4">Notre localisation</h2>
        <p class="text-xl text-gray-300">
          Situés en Alsace, nous sommes facilement accessibles 
          pour des réunions en présentiel.
        </p>
      </div>
      <div id="map" class="h-96 rounded-xl shadow-lg border border-gray-700/30"></div>
    </div>
  </section>
</MainLayout>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<!-- Leaflet JavaScript -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  // Form handling
  const contactForm = document.getElementById('contact-form');
  
  if (contactForm) {
    contactForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Get form data
      const formData = new FormData(contactForm);
      const data = Object.fromEntries(formData);
      
      // Here you would typically send the data to your backend
      console.log('Form submitted:', data);
      
      // Show success message (in a real app, you'd handle this properly)
      alert('Merci pour votre message ! Nous vous contacterons dans les plus brefs délais.');
      
      // Reset form
      contactForm.reset();
    });
  }

  // Map initialization
  document.addEventListener('DOMContentLoaded', function() {
    const map = L.map('map').setView([46.603354, 1.888334], 6); // Vue de la France entière
    
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);
    
    // Ajouter un marqueur pour votre adresse
    const marker = L.marker([48.4717, 7.2467]).addTo(map);
    marker.bindPopup('<b>Finckia</b><br>25 rue du Falkenstein<br>67220 Saint-Pierre-Bois, Alsace').openPopup();
  });
</script>

<style>
  @keyframes gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes gradient-text {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  .animate-gradient {
    background-size: 400% 400%;
    animation: gradient 15s ease infinite;
  }
  
  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }
  
  .animate-fade-in-delay {
    animation: fade-in 1s ease-out 0.3s both;
  }
  
  .animate-gradient-text {
    background-size: 200% 200%;
    animation: gradient-text 3s ease infinite;
  }
</style>
