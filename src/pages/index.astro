---
import MainLayout from '../layouts/MainLayout.astro';
import Chatbot from '../components/Chatbot.astro';

// Métadonnées Open Graph complètes pour le partage social
const ogTitle = "Finckia - Développement SaaS sur mesure avec IA | Alain Finckenbein";
const ogDescription = "Transformez vos idées en solutions digitales innovantes. Spécialiste du développement de logiciels SaaS sur mesure avec intelligence artificielle. Basé en Alsace.";
const ogImage = "/img/team/alain-finckenbein.png";
const ogType = "website";
const twitterCard = "summary_large_image";
---

<MainLayout 
  title={ogTitle}
  description={ogDescription}
  image={ogImage}
  ogType={ogType}
  twitterCard={twitterCard}
>
  <!-- Hero Section avec fond sombre animé -->
  <section class="relative bg-gray-900 overflow-hidden py-32">
    <!-- Particules animées en arrière-plan -->
    <div class="absolute inset-0 z-10">
      <!-- Étoiles statiques discrètes -->
      <div class="absolute top-20 left-10 w-2 h-2 bg-white rounded-full opacity-60 shadow-sm"></div>
      <div class="absolute top-40 right-20 w-1.5 h-1.5 bg-white rounded-full opacity-50 shadow-sm"></div>
      <div class="absolute bottom-20 left-1/4 w-2 h-2 bg-white rounded-full opacity-70 shadow-sm"></div>
      <div class="absolute top-1/2 right-1/3 w-1.5 h-1.5 bg-white rounded-full opacity-45 shadow-sm"></div>
      <div class="absolute bottom-40 right-10 w-2 h-2 bg-white rounded-full opacity-65 shadow-sm"></div>
      
      <!-- Étoiles animées discrètes -->
      <div class="absolute top-32 left-1/4 w-2 h-2 bg-primary-400 rounded-full animate-pulse opacity-40 shadow-sm"></div>
      <div class="absolute top-48 right-1/3 w-1.5 h-1.5 bg-primary-300 rounded-full animate-ping opacity-35 shadow-sm"></div>
      <div class="absolute bottom-32 left-1/3 w-2 h-2 bg-primary-500 rounded-full animate-bounce opacity-45 shadow-sm"></div>
    </div>
    
    <!-- Gradient animé -->
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-primary-900 animate-gradient"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <!-- Icône fusée animée -->
        <div class="flex justify-center mb-8">
          <div class="relative">
            <div class="w-24 h-24 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full flex items-center justify-center shadow-2xl animate-float-slow">
              <i class="fas fa-rocket text-white text-4xl"></i>
            </div>
            <!-- Traînée de la fusée -->
            <div class="absolute -left-8 top-1/2 transform -translate-y-1/2 w-16 h-1 bg-gradient-to-r from-transparent via-primary-400 to-transparent opacity-60 animate-pulse"></div>
          </div>
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 animate-fade-in">
          Développement SaaS sur mesure
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-primary-600 animate-gradient-text">
            innovant
          </span>
        </h1>
        <p class="text-2xl md:text-3xl text-primary-300 mb-4 animate-fade-in-delay font-semibold">
          Faites décoller vos idées
        </p>
        <p class="text-xl md:text-2xl text-gray-300 mb-10 max-w-4xl mx-auto animate-fade-in-delay">
          Transformez vos idées en solutions digitales innovantes. Nous créons des logiciels SaaS 
          personnalisés pour optimiser vos processus métier et accélérer votre croissance.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center animate-fade-in-delay-2">
          <a
            href="/contact"
            class="bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white px-10 py-5 rounded-xl text-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-primary-500/25"
          >
            Démarrer un projet
          </a>
          <a
            href="/services"
            class="border-2 border-primary-500 text-primary-400 hover:bg-primary-500 hover:text-white px-10 py-5 rounded-xl text-lg font-semibold transition-all duration-300 transform hover:scale-105 backdrop-blur-sm"
          >
            Découvrir nos services
          </a>
          <a
            href="/hosting"
            class="border-2 border-primary-400 text-primary-300 hover:bg-primary-400 hover:text-white px-10 py-5 rounded-xl text-lg font-semibold transition-all duration-300 transform hover:scale-105 backdrop-blur-sm"
          >
            Hébergement Django
          </a>
        </div>
      </div>
    </div>
    
    <!-- Flèche de défilement animée -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce-slow">
      <div class="w-8 h-8 text-white opacity-70 hover:opacity-100 transition-opacity duration-300 cursor-pointer">
        <svg fill="currentColor" viewBox="0 0 24 24">
          <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- Features Section avec design moderne -->
  <section class="py-24 bg-gray-800 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-800 to-gray-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Pourquoi choisir <span class="text-primary-400">Finckia</span> ?
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Notre expertise combine développement moderne et innovation 
          pour créer des solutions qui transforment votre entreprise.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="text-center p-8 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Innovation technologique</h3>
          <p class="text-gray-300">
            Utilisation des technologies les plus avancées pour créer des solutions performantes et évolutives.
          </p>
        </div>

        <div class="text-center p-8 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Solutions sur mesure</h3>
          <p class="text-gray-300">
            Développement personnalisé adapté à vos besoins spécifiques et à votre secteur d'activité.
          </p>
        </div>

        <div class="text-center p-8 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Performance</h3>
          <p class="text-gray-300">
            Applications haute performance, scalables et optimisées pour une expérience utilisateur exceptionnelle.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview avec design sombre -->
  <section class="py-24 bg-gray-900 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900 to-black"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Nos <span class="text-primary-400">services</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Une gamme complète de services pour accompagner votre transformation digitale.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Développement SaaS</h3>
          <p class="text-gray-300 mb-6">
            Création d'applications SaaS complètes, de la conception à la mise en production.
          </p>
          <a href="/services" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            En savoir plus →
          </a>
        </div>

        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Intelligence Artificielle</h3>
          <p class="text-gray-300 mb-6">
            Intégration d'IA et de machine learning pour automatiser et optimiser vos processus.
          </p>
          <a href="/services" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            En savoir plus →
          </a>
        </div>

        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Consulting & Formation</h3>
          <p class="text-gray-300 mb-6">
            Accompagnement stratégique et formation de vos équipes aux nouvelles technologies.
          </p>
          <a href="/services" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            En savoir plus →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- À propos du fondateur -->
  <section class="py-24 bg-gray-800 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-800 to-gray-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
            Rencontrez-moi
          </h2>
          <p class="text-xl text-gray-300 mb-6">
            Fondateur et CEO de Finckia, Alain est un expert passionné en développement SaaS 
            et solutions cloud. Avec plus de 15 ans d'expérience dans l'industrie technologique, 
            il combine expertise technique et vision stratégique pour créer des solutions innovantes.
          </p>
          <p class="text-lg text-gray-300 mb-8">
            Basé en Alsace, Alain accompagne les entreprises dans leur transformation digitale 
            en développant des applications sur mesure qui répondent parfaitement à leurs besoins.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/about" class="bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg">
              En savoir plus
            </a>
            <a href="/contact" class="border-2 border-primary-500 text-primary-400 hover:bg-primary-500 hover:text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105">
              Me contacter
            </a>
          </div>
        </div>
        <div class="flex justify-center">
          <div class="relative">
            <div class="w-80 h-80 bg-gradient-to-br from-primary-500 to-primary-600 rounded-3xl p-2 shadow-2xl">
              <img src="/img/team/alain-finckenbein.png" alt="Alain Finckenbein - Fondateur de Finckia" class="w-full h-full object-contain rounded-2xl bg-transparent" />
            </div>
            <div class="absolute -bottom-4 -right-4 w-20 h-20 bg-gradient-to-br from-primary-400 to-primary-600 rounded-2xl flex items-center justify-center shadow-lg">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projets d'exemple -->
  <section class="py-24 bg-gray-900 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900 to-gray-800"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Projets <span class="text-primary-400">d'exemple</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Découvrez quelques-uns de nos projets récents qui illustrent notre expertise 
          en développement SaaS et solutions d'IA.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Projet 1 -->
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <i class="fas fa-chart-line text-white text-2xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Dashboard Analytics</h3>
          <p class="text-gray-300 mb-6">
            Tableau de bord interactif pour visualiser les données métier en temps réel avec des graphiques avancés.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Django</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">PostgreSQL</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Chart.js</span>
          </div>
          <a href="/projects" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            Voir le projet →
          </a>
        </div>

        <!-- Projet 2 -->
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <i class="fas fa-robot text-white text-2xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Chatbot IA</h3>
          <p class="text-gray-300 mb-6">
            Assistant virtuel intelligent pour automatiser le support client avec traitement du langage naturel.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Python</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">OpenAI</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">WebSocket</span>
          </div>
          <a href="/projects" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            Voir le projet →
          </a>
        </div>

        <!-- Projet 3 -->
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <i class="fas fa-shopping-cart text-white text-2xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">E-commerce SaaS</h3>
          <p class="text-gray-300 mb-6">
            Plateforme e-commerce complète avec gestion des produits, paiements et analytics intégrés.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Django</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Stripe</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Redis</span>
          </div>
          <a href="/projects" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            Voir le projet →
          </a>
        </div>

        <!-- Projet 4 -->
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <i class="fas fa-cogs text-white text-2xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Automatisation CRM</h3>
          <p class="text-gray-300 mb-6">
            Système de gestion de la relation client avec automatisation des workflows et intégrations.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Django</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Celery</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">API REST</span>
          </div>
          <a href="/projects" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            Voir le projet →
          </a>
        </div>

        <!-- Projet 5 -->
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <i class="fas fa-file-alt text-white text-2xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Gestion Documentaire</h3>
          <p class="text-gray-300 mb-6">
            Plateforme de gestion documentaire avec OCR et recherche intelligente dans les documents.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Django</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Elasticsearch</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Tesseract</span>
          </div>
          <a href="/projects" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            Voir le projet →
          </a>
        </div>

        <!-- Projet 6 -->
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <i class="fas fa-users text-white text-2xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Plateforme RH</h3>
          <p class="text-gray-300 mb-6">
            Application de gestion des ressources humaines avec recrutement et suivi des performances.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Django</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">PostgreSQL</span>
            <span class="px-3 py-1 bg-primary-600/20 text-primary-300 rounded-full text-sm">Vue.js</span>
          </div>
          <a href="/projects" class="text-primary-400 hover:text-primary-300 font-medium transition-colors duration-200">
            Voir le projet →
          </a>
        </div>
      </div>
      
      <!-- CTA pour voir tous les projets -->
      <div class="text-center mt-16">
        <a
          href="/projects"
