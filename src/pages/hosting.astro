---
import MainLayout from '../layouts/MainLayout.astro';

// Métadonnées Open Graph complètes pour le partage social
const ogTitle = "Hébergement SaaS Django - Solutions Cloud Professionnelles | Finckia";
const ogDescription = "Hébergez votre SaaS Django avec nos solutions cloud professionnelles. Infrastructure scalable, sécurité renforcée et support 24/7. Basé en Alsace.";
const ogImage = "/img/team/alain-finckenbein.png";
const ogType = "website";
const twitterCard = "summary_large_image";
---

<MainLayout 
  title={ogTitle}
  description={ogDescription}
  image={ogImage}
  ogType={ogType}
  twitterCard={twitterCard}
>
  <!-- Hero Section avec fond sombre animé -->
  <section class="relative bg-gray-900 overflow-hidden py-32">
    <!-- Particules animées en arrière-plan -->
    <div class="absolute inset-0 z-10">
      <!-- Étoiles statiques discrètes -->
      <div class="absolute top-20 left-10 w-2 h-2 bg-white rounded-full opacity-60 shadow-sm"></div>
      <div class="absolute top-40 right-20 w-1.5 h-1.5 bg-white rounded-full opacity-50 shadow-sm"></div>
      <div class="absolute bottom-20 left-1/4 w-2 h-2 bg-white rounded-full opacity-70 shadow-sm"></div>
      <div class="absolute top-1/2 right-1/3 w-1.5 h-1.5 bg-white rounded-full opacity-45 shadow-sm"></div>
      <div class="absolute bottom-40 right-10 w-2 h-2 bg-white rounded-full opacity-65 shadow-sm"></div>
      
      <!-- Étoiles animées discrètes -->
      <div class="absolute top-32 left-1/4 w-2 h-2 bg-primary-400 rounded-full animate-pulse opacity-40 shadow-sm"></div>
      <div class="absolute top-48 right-1/3 w-1.5 h-1.5 bg-primary-300 rounded-full animate-ping opacity-35 shadow-sm"></div>
      <div class="absolute bottom-32 left-1/3 w-2 h-2 bg-primary-500 rounded-full animate-bounce opacity-45 shadow-sm"></div>
    </div>
    
    <!-- Gradient animé -->
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-primary-900 animate-gradient"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <!-- Icône serveur animée -->
        <div class="flex justify-center mb-8">
          <div class="relative">
            <div class="w-24 h-24 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full flex items-center justify-center shadow-2xl animate-float-slow">
              <i class="fas fa-server text-white text-4xl"></i>
            </div>
            <!-- Traînée du serveur -->
            <div class="absolute -left-8 top-1/2 transform -translate-y-1/2 w-16 h-1 bg-gradient-to-r from-transparent via-primary-400 to-transparent opacity-60 animate-pulse"></div>
          </div>
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 animate-fade-in">
          Hébergement SaaS Django
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-primary-600 animate-gradient-text">
            professionnel
          </span>
        </h1>
        <p class="text-2xl md:text-3xl text-primary-300 mb-4 animate-fade-in-delay font-semibold">
          Infrastructure cloud de qualité entreprise
        </p>
        <p class="text-xl md:text-2xl text-gray-300 mb-10 max-w-4xl mx-auto animate-fade-in-delay">
          Hébergez votre application SaaS Django avec nos solutions cloud scalables et sécurisées. 
          Performance optimale, sécurité renforcée et support technique 24/7.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center animate-fade-in-delay-2">
          <a
            href="/contact"
            class="bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white px-10 py-5 rounded-xl text-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-primary-500/25"
          >
            Demander un devis
          </a>
          <a
            href="#services"
            class="border-2 border-primary-500 text-primary-400 hover:bg-primary-500 hover:text-white px-10 py-5 rounded-xl text-lg font-semibold transition-all duration-300 transform hover:scale-105 backdrop-blur-sm"
          >
            Découvrir nos offres
          </a>
        </div>
      </div>
    </div>
    
    <!-- Flèche de défilement animée -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce-slow">
      <div class="w-8 h-8 text-white opacity-70 hover:opacity-100 transition-opacity duration-300 cursor-pointer">
        <svg fill="currentColor" viewBox="0 0 24 24">
          <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- Avantages de l'hébergement -->
  <section class="py-24 bg-gray-800 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-800 to-gray-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Pourquoi choisir notre <span class="text-primary-400">hébergement</span> ?
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Une infrastructure cloud de qualité entreprise pour garantir la performance 
          et la fiabilité de votre SaaS Django.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="text-center p-8 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <i class="fas fa-rocket text-white text-3xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Performance optimale</h3>
          <p class="text-gray-300">
            Infrastructure haute performance avec SSD NVMe, CDN et optimisation automatique pour des temps de réponse ultra-rapides.
          </p>
        </div>

        <div class="text-center p-8 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <i class="fas fa-shield-alt text-white text-3xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Sécurité renforcée</h3>
          <p class="text-gray-300">
            Protection DDoS, SSL/TLS, pare-feu avancé et sauvegardes automatiques pour sécuriser vos données et votre application.
          </p>
        </div>

        <div class="text-center p-8 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <i class="fas fa-expand-arrows-alt text-white text-3xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Scalabilité automatique</h3>
          <p class="text-gray-300">
            Mise à l'échelle automatique selon la charge, avec possibilité d'ajuster les ressources en temps réel selon vos besoins.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services d'hébergement -->
  <section id="services" class="py-24 bg-gray-900 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900 to-black"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Nos <span class="text-primary-400">offres</span> d'hébergement
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Des solutions adaptées à tous les besoins, de la startup en croissance 
          aux entreprises établies.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Offre Starter -->
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="text-center mb-8">
            <h3 class="text-2xl font-semibold text-white mb-4">Starter</h3>
            <div class="text-4xl font-bold text-primary-400 mb-2">99€</div>
            <div class="text-gray-400">/mois</div>
          </div>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              2 vCPU, 4 GB RAM
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              80 GB SSD NVMe
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              CDN inclus
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              SSL/TLS gratuit
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              Sauvegardes quotidiennes
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              Support email
            </li>
          </ul>
          <a href="/contact" class="w-full bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg text-center block">
            Commencer
          </a>
        </div>

        <!-- Offre Professional -->
        <div class="bg-gradient-to-br from-primary-600 to-primary-700 rounded-2xl border border-primary-500/50 p-8 transform scale-105 shadow-2xl">
          <div class="text-center mb-8">
            <div class="bg-white/20 text-white px-4 py-1 rounded-full text-sm font-semibold mb-4 inline-block">
              POPULAIRE
            </div>
            <h3 class="text-2xl font-semibold text-white mb-4">Professional</h3>
            <div class="text-4xl font-bold text-white mb-2">199€</div>
            <div class="text-primary-100">/mois</div>
          </div>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center text-white">
              <i class="fas fa-check text-white mr-3"></i>
              4 vCPU, 8 GB RAM
            </li>
            <li class="flex items-center text-white">
              <i class="fas fa-check text-white mr-3"></i>
              160 GB SSD NVMe
            </li>
            <li class="flex items-center text-white">
              <i class="fas fa-check text-white mr-3"></i>
              CDN premium
            </li>
            <li class="flex items-center text-white">
              <i class="fas fa-check text-white mr-3"></i>
              SSL/TLS wildcard
            </li>
            <li class="flex items-center text-white">
              <i class="fas fa-check text-white mr-3"></i>
              Sauvegardes horaires
            </li>
            <li class="flex items-center text-white">
              <i class="fas fa-check text-white mr-3"></i>
              Support prioritaire
            </li>
            <li class="flex items-center text-white">
              <i class="fas fa-check text-white mr-3"></i>
              Monitoring 24/7
            </li>
            <li class="flex items-center text-white">
              <i class="fas fa-check text-white mr-3"></i>
              Scalabilité automatique
            </li>
          </ul>
          <a href="/contact" class="w-full bg-white text-primary-600 hover:bg-gray-100 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg text-center block">
            Commencer
          </a>
        </div>

        <!-- Offre Enterprise -->
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="text-center mb-8">
            <h3 class="text-2xl font-semibold text-white mb-4">Enterprise</h3>
            <div class="text-4xl font-bold text-primary-400 mb-2">399€</div>
            <div class="text-gray-400">/mois</div>
          </div>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              8 vCPU, 16 GB RAM
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              320 GB SSD NVMe
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              CDN global
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              SSL/TLS wildcard
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              Sauvegardes en temps réel
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              Support dédié 24/7
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              Monitoring avancé
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              Load balancing
            </li>
            <li class="flex items-center text-gray-300">
              <i class="fas fa-check text-primary-400 mr-3"></i>
              SLA 99.9%
            </li>
          </ul>
          <a href="/contact" class="w-full bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg text-center block">
            Commencer
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Infrastructure technique -->
  <section class="py-24 bg-gray-800 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-800 to-gray-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Infrastructure <span class="text-primary-400">technique</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Une stack technique moderne et robuste pour garantir la performance 
          et la fiabilité de votre application.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center p-6 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fab fa-python text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Python 3.11+</h3>
          <p class="text-gray-300 text-sm">
            Version stable et performante
          </p>
        </div>

        <div class="text-center p-6 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fas fa-database text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">PostgreSQL 15</h3>
          <p class="text-gray-300 text-sm">
            Base de données robuste
          </p>
        </div>

        <div class="text-center p-6 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fas fa-memory text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Redis 7</h3>
          <p class="text-gray-300 text-sm">
            Cache et sessions
          </p>
        </div>

        <div class="text-center p-6 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fas fa-server text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Nginx</h3>
          <p class="text-gray-300 text-sm">
            Serveur web performant
          </p>
        </div>

        <div class="text-center p-6 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fas fa-cloud text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Docker</h3>
          <p class="text-gray-300 text-sm">
            Conteneurisation
          </p>
        </div>

        <div class="text-center p-6 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fas fa-sync text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Celery</h3>
          <p class="text-gray-300 text-sm">
            Tâches asynchrones
          </p>
        </div>

        <div class="text-center p-6 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fas fa-chart-line text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Monitoring</h3>
          <p class="text-gray-300 text-sm">
            Surveillance temps réel
          </p>
        </div>

        <div class="text-center p-6 bg-gray-700/50 backdrop-blur-sm rounded-2xl border border-gray-600/30 hover:bg-gray-700/70 transition-all duration-300 transform hover:scale-105">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fas fa-shield-alt text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Sécurité</h3>
          <p class="text-gray-300 text-sm">
            Protection avancée
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services inclus -->
  <section class="py-24 bg-gray-900 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900 to-black"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Services <span class="text-primary-400">inclus</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Tout ce dont vous avez besoin pour faire fonctionner votre SaaS Django 
          de manière optimale.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 hover:border-primary-500/50">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6">
            <i class="fas fa-cogs text-white text-2xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Configuration initiale</h3>
          <ul class="space-y-3 text-gray-300">
            <li class="flex items-start">
              <i class="fas fa-check text-primary-400 mr-3 mt-1"></i>
              Installation et configuration de Django
            </li>
            <li class="flex items-start">
              <i class="fas fa-check text-primary-400 mr-3 mt-1"></i>
