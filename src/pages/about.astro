---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="À propos - Finckia - Développement SaaS sur mesure avec IA">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-50 to-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          À propos de Finckia
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Nous sommes une équipe passionnée de développeurs et d'experts en IA, 
          dédiés à la création de solutions SaaS innovantes qui transforment les entreprises.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Notre Mission
          </h2>
          <p class="text-lg text-gray-600 mb-6">
            Chez Finckia, nous croyons que l'intelligence artificielle peut révolutionner 
            la façon dont les entreprises opèrent. Notre mission est de démocratiser 
            l'accès à ces technologies en créant des solutions SaaS sur mesure, 
            accessibles et performantes.
          </p>
          <p class="text-lg text-gray-600 mb-6">
            Nous accompagnons nos clients dans leur transformation digitale en combinant 
            expertise technique, innovation et vision stratégique pour créer des 
            applications qui génèrent une vraie valeur ajoutée.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex items-center">
              <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Innovation</h3>
                <p class="text-gray-600">Technologies de pointe</p>
              </div>
            </div>
            <div class="flex items-center">
              <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Performance</h3>
                <p class="text-gray-600">Solutions optimisées</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 rounded-xl p-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">Nos Valeurs</h3>
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center mr-4 mt-1">
                <span class="text-primary-600 font-bold text-sm">1</span>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-2">Excellence technique</h4>
                <p class="text-gray-600">Nous maintenons les plus hauts standards de qualité dans tous nos développements.</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center mr-4 mt-1">
                <span class="text-primary-600 font-bold text-sm">2</span>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-2">Innovation continue</h4>
                <p class="text-gray-600">Nous explorons constamment les nouvelles technologies pour améliorer nos solutions.</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center mr-4 mt-1">
                <span class="text-primary-600 font-bold text-sm">3</span>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-2">Collaboration</h4>
                <p class="text-gray-600">Nous travaillons en étroite collaboration avec nos clients pour comprendre leurs besoins.</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center mr-4 mt-1">
                <span class="text-primary-600 font-bold text-sm">4</span>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-2">Impact positif</h4>
                <p class="text-gray-600">Nous créons des solutions qui ont un impact positif sur les entreprises et leurs utilisateurs.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Notre Équipe
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Une équipe d'experts passionnés par la technologie et l'innovation, 
          dédiés à créer des solutions exceptionnelles pour nos clients.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-8 text-center shadow-lg">
          <div class="w-24 h-24 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-12 h-12 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Développeurs Full-Stack</h3>
          <p class="text-gray-600 mb-4">
            Experts en développement frontend et backend avec une maîtrise des technologies modernes.
          </p>
          <div class="flex justify-center space-x-2">
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">React</span>
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">Node.js</span>
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">Python</span>
          </div>
        </div>

        <div class="bg-white rounded-xl p-8 text-center shadow-lg">
          <div class="w-24 h-24 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-12 h-12 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Experts IA/ML</h3>
          <p class="text-gray-600 mb-4">
            Spécialistes en intelligence artificielle et machine learning pour créer des solutions intelligentes.
          </p>
          <div class="flex justify-center space-x-2">
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">TensorFlow</span>
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">PyTorch</span>
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">OpenAI</span>
          </div>
        </div>

        <div class="bg-white rounded-xl p-8 text-center shadow-lg">
          <div class="w-24 h-24 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-12 h-12 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">DevOps & Cloud</h3>
          <p class="text-gray-600 mb-4">
            Ingénieurs spécialisés dans le déploiement, la maintenance et l'optimisation des infrastructures cloud.
          </p>
          <div class="flex justify-center space-x-2">
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">AWS</span>
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">Docker</span>
            <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">K8s</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-20 bg-primary-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl md:text-5xl font-bold text-white mb-2">50+</div>
          <div class="text-primary-100">Projets réalisés</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold text-white mb-2">30+</div>
          <div class="text-primary-100">Clients satisfaits</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold text-white mb-2">5+</div>
          <div class="text-primary-100">Années d'expérience</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold text-white mb-2">99.9%</div>
          <div class="text-primary-100">Disponibilité</div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>





