---
// Navigation data
const navItems = [
  { name: 'Accueil', href: '/', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { name: 'Services', href: '/services', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { name: 'SaaS Django', href: '/saas-django', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { name: 'Hébergement', href: '/hosting', icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2M8 8h.01M12 8h.01M16 8h.01M9 12h.01M13 12h.01M17 12h.01M9 16h.01M13 16h.01M17 16h.01' },
  { name: 'Technologies', href: '/technologies', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { name: 'À propos', href: '/about', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { name: 'Contact', href: '/contact', icon: 'M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' }
];
---

<header class="bg-gray-900 shadow-lg border-b border-gray-800 sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-24">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center">
          <div class="relative">
            <!-- Halo lumineux animé -->
            <div class="absolute inset-0 bg-gradient-to-r from-primary-400 via-primary-500 to-primary-600 rounded-full opacity-20 animate-pulse blur-xl scale-110"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-primary-300 via-primary-400 to-primary-500 rounded-full opacity-30 animate-pulse blur-lg scale-105 delay-1000"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-primary-200 via-primary-300 to-primary-400 rounded-full opacity-40 animate-pulse blur-md scale-100 delay-2000"></div>
            
            <!-- Fond blanc derrière le logo -->
            <div class="absolute inset-0 bg-white rounded-full p-4 shadow-lg"></div>
            
            <!-- Effet de bordure animée -->
            <div class="absolute inset-0 bg-gradient-to-r from-primary-400 to-primary-600 rounded-full opacity-30 animate-spin-slow"></div>
            
            <img src="/img/logo-finckia2-clair.png" alt="Logo Finckia" class="h-32 w-32 object-contain relative z-10 animate-header-logo" />
          </div>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:block">
        <div class="ml-6 flex items-baseline space-x-4">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="text-gray-300 hover:text-primary-400 px-3 py-2 text-sm font-medium transition-all duration-200 flex items-center space-x-1.5 hover:bg-gray-800 rounded-lg whitespace-nowrap"
            >
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
              <span>{item.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <a
          href="/contact"
          class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 transform hover:scale-105 shadow-lg hover:shadow-xl border border-primary-500"
        >
          Démarrer un projet
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          type="button"
          class="text-gray-300 hover:text-primary-400 p-3 rounded-lg hover:bg-gray-800 transition-all duration-200"
          id="mobile-menu-button"
          aria-label="Menu mobile"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div class="md:hidden hidden" id="mobile-menu">
      <div class="px-2 pt-2 pb-3 space-y-2 sm:px-3 border-t border-gray-800">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-gray-300 hover:text-primary-400 block px-4 py-3 text-base font-medium rounded-lg hover:bg-gray-800 transition-all duration-200 flex items-center space-x-3"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
            </svg>
            <span>{item.name}</span>
          </a>
        ))}
        <a
          href="/contact"
          class="bg-primary-600 hover:bg-primary-700 text-white block px-4 py-3 rounded-lg text-base font-medium mt-4 transition-all duration-200"
        >
          Démarrer un projet
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>

<style>
  @keyframes header-logo {
    0%, 100% { 
      transform: scale(1) translateY(0px);
    }
    25% { 
      transform: scale(1.01) translateY(-1px);
    }
    50% { 
      transform: scale(1.01) translateY(0px);
    }
    75% { 
      transform: scale(1.01) translateY(1px);
    }
  }
  
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  .animate-header-logo {
    animation: header-logo 8s ease-in-out infinite;
  }
  
  .animate-header-logo:hover {
    animation: header-logo 3s ease-in-out infinite;
  }
  
  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }
</style>
