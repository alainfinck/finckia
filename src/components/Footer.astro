    75% { 
      transform: translateY(-1.5px) translateX(0.25px);
      background-color: rgb(236 72 153); /* pink-500 */
    }
  }
  
  @keyframes float-2 {
    0%, 100% { 
      transform: translateY(0px) translateX(0px);
      background-color: rgb(168 85 247); /* purple-400 */
