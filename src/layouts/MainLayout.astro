---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  twitterCard?: string;
}

const { 
  title, 
  description = "Spécialiste du développement de logiciels SaaS sur mesure avec intelligence artificielle",
  image = "/img/logo-finckia2.png",
  ogType = "website",
  twitterCard = "summary_large_image"
} = Astro.props;
---

<Layout title={title} description={description} image={image} ogType={ogType} twitterCard={twitterCard}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</Layout>
